---
import { alternates, langFromUrl, type Lang } from '../../lib/i18n';
import { getCopy } from '../../lib/copy';

const actual: Lang = langFromUrl(Astro.url);
const opciones = alternates(Astro.url.pathname);
// El texto que rodea al conmutador debe hablar el idioma de LA PÁGINA
// ACTUAL, no el del destino (ver a11y.idiomaActual / a11y.verEnIdioma).
const copy = getCopy(actual);

const etiqueta: Record<Lang, string> = { es: 'ES', en: 'EN' };
---

<nav class="flex items-center gap-2" aria-label={copy.a11y.idioma}>
  {
    opciones.map(({ lang, href }) =>
      lang === actual ? (
        <span
          class="text-kicker uppercase tracking-[0.2em] text-copal"
          aria-current="true"
        >
          <span class="sr-only">
            {copy.a11y.nombresIdioma[lang]}, {copy.a11y.idiomaActual}
          </span>
          <span aria-hidden="true">{etiqueta[lang]}</span>
        </span>
      ) : (
        <a
          href={href}
          hreflang={lang}
          class="text-kicker uppercase tracking-[0.2em] opacity-70 transition-opacity hover:opacity-100"
        >
          <span class="sr-only">
            {copy.a11y.verEnIdioma} {copy.a11y.nombresIdioma[lang]}
          </span>
          <span aria-hidden="true">{etiqueta[lang]}</span>
        </a>
      ),
    )
  }
</nav>
