---
import Base from '../layouts/Base.astro';
import Seccion from '../components/ui/Seccion.astro';
import Boton from '../components/ui/Boton.astro';
import { getCopy } from '../lib/copy';

// El 404 de Astro es único para todo el sitio (no hay en/404.astro):
// se deja en español y el botón vuelve siempre a la raíz.
const lang = 'es' as const;
const copy = getCopy(lang);
---

<Base
  titulo={`${copy.error404.titulo} · Dharma Fest`}
  descripcion={copy.error404.cuerpo}
  lang={lang}
  rutaCanonica="/404"
>
  <Seccion fondo="bosque" class="min-h-[70svh] text-center">
    <h1 class="font-display text-hero text-lino">{copy.error404.titulo}</h1>
    <p class="mx-auto mt-6 text-arena">{copy.error404.cuerpo}</p>
    <Boton href="/" class="mt-10">{copy.error404.volver}</Boton>
  </Seccion>
</Base>
