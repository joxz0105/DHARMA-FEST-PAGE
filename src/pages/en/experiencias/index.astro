---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Seccion from '../../../components/ui/Seccion.astro';
import Kicker from '../../../components/ui/Kicker.astro';
import TarjetaExperiencia from '../../../components/ui/TarjetaExperiencia.astro';
import TituloSeccion from '../../../components/ui/TituloSeccion.astro';
import Reveal from '../../../components/ui/Reveal.astro';
import Sumate from '../../../components/sections/Sumate.astro';
import { getCopy } from '../../../lib/copy';
import { experienciasDe } from '../../../lib/contenido';

const lang = 'en' as const;
const copy = getCopy(lang);

const todas = experienciasDe(
  (await getCollection('experiencias')).map((e) => ({ slug: e.id, ...e.data })),
  lang,
);

const proximas = todas.filter((e) => e.estado === 'proxima');
const pasadas = todas.filter((e) => e.estado === 'pasada');
---

<Base
  titulo={`${copy.experiencias.titulo} ${copy.experiencias.tituloEnfasis} · Dharma Fest`}
  descripcion={copy.experiencias.vacio}
  lang={lang}
  rutaCanonica="/experiencias"
>
  <!--
    Encabezado en fondo oscuro, igual que /marcas y /nosotros: el header del
    sitio flota transparente sobre el tope de la página, y su texto es claro.
    Sin una franja oscura detrás, queda invisible sobre un fondo lino.
  -->
  <Seccion fondo="bosque" class="pt-40">
    <Kicker tono="oscuro">{copy.experiencias.kicker}</Kicker>
    <h1 class="mt-4 font-display text-hero text-lino">
      {copy.experiencias.titulo} <em class="italic">{copy.experiencias.tituloEnfasis}</em>
    </h1>
  </Seccion>

  <Seccion>
    {
      proximas.length > 0 && (
        <>
          <TituloSeccion texto={copy.experiencias.tituloProximas} nivel={2} />
          <div data-grupo="proximas" class="mt-8 grid gap-8 md:grid-cols-3">
            {proximas.map((e, i) => (
              <Reveal indice={i}><TarjetaExperiencia {...e} lang={lang} /></Reveal>
            ))}
          </div>
        </>
      )
    }

    {
      pasadas.length > 0 && (
        <>
          <TituloSeccion texto={copy.experiencias.tituloPasadas} nivel={2} class="mt-16" />
          <div data-grupo="pasadas" class="mt-8 grid gap-8 md:grid-cols-3">
            {pasadas.map((e, i) => (
              <Reveal indice={i}><TarjetaExperiencia {...e} lang={lang} /></Reveal>
            ))}
          </div>
        </>
      )
    }

    {todas.length === 0 && <p class="mt-16 text-salvia">{copy.experiencias.vacio}</p>}
  </Seccion>

  <Sumate lang={lang} />
</Base>
